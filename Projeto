#include <iostream>
using namespace std;


struct Birigui {
	string TipoProblema[10], Urgencia[10], Horario[10];
	int ContadorProblemas = 0;
	};

void Cadastro(Birigui loc[5][5], int& Tam) {
	int PontoX, PontoY, urgencia;

	cout << "Qual ponto voce registrara o problema?" << endl;
	cout << "Ponto X (0 a 4): ";
	cin >> PontoX;
	cout << "Ponto Y (0 a 4): ";
	cin >> PontoY;
	int pos = loc[PontoX][PontoY].ContadorProblemas;
	loc[PontoX][PontoY].ContadorProblemas++;
	cout << "Qual problema deseja reportar: ";
	cin >> loc[PontoX][PontoY].TipoProblema[pos];
	system("cls");
	cout << "Qual a urgencia do seu problema: " << endl << "[1] - normal" << endl << "[2] - prioridade" << endl << "[3] - prioridade maxima" << endl << "escolha: ";
	cin >> urgencia;
	switch (urgencia) {
	case 1:
		loc[PontoX][PontoY].Urgencia[pos] = "Normal";
		break;
	case 2:
		loc[PontoX][PontoY].Urgencia[pos] = "Prioridade Media";
		break;
	case 3:
		loc[PontoX][PontoY].Urgencia[pos] = "Prioridade Maxima";
		break;
	default:
		cout << "opcao invalida!";
		break;
	}

	cout << "Qual o horario da ocorrencia? (Manha, tarde, noite)" << endl;
	cin >> loc[PontoX][PontoY].Horario[pos];

	Tam++;
	system("pause");
	system("cls");
}

