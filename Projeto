}

void Imprimir(Birigui loc[5][5], int tam) {
	char Especificar;
	for (int linha = 0; linha < 5; linha++) {
		for (int coluna = 0; coluna < 5; coluna++) {
			cout << loc[linha][coluna].ContadorProblemas << " ";
		}
		cout << endl;
	}
	cout << endl << "Temos no total " << tam << " problemas na cidade" << endl;

