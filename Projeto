			cout << "Urgencia: " << loc[PontoX][PontoY].Urgencia[cont] << "   ";
			cout << "Horario - " << loc[PontoX][PontoY].Horario[cont] << endl;


		}
	}
	else {
		cout << "Nao temos problemas nesse ponto!" << endl;
	}
